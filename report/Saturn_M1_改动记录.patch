+
+// The launcher persists scalars as "key=<type>|<value>" and silently DROPS any
+// line without a recognised type tag (ConfigManager::DeserializeValue).  The
+// in-game settings menu writes back into that same file, so every value it
+// touches has to keep a tag: reuse the one the key already had, and infer one
+// for keys the launcher has not written yet.
+const char* InferConfigTag(const std::string& value)
+{
+  if (value.empty())
+    return "s";
+  char* end = nullptr;
+  (void)std::strtol(value.c_str(), &end, 10);
+  if (end != nullptr && *end == '\0')
+    return "i";
+  end = nullptr;
+  (void)std::strtod(value.c_str(), &end);
+  if (end != nullptr && *end == '\0')
+    return "f";
+  return "s";
+}
+
+std::string EncodeConfigValue(const char* tag, const std::string& value)
+{
+  std::string out = std::string(tag) + "|";
+  if (std::strcmp(tag, "s") != 0)
+  {
+    out += value;
+    return out;
+  }
+  // Same escaping the launcher applies to string payloads.
+  for (const char c : value)
+  {
+    if (c == '\\' || c == ',' || c == '|')
+      out.push_back('\\');
+    out.push_back(c);
+  }
+  return out;
+}
+
+std::string ConfigTagOf(const std::string& raw_value)
+{
+  if (raw_value.size() >= 2 && raw_value[1] == '|' &&
+      (raw_value[0] == 'i' || raw_value[0] == 'f' || raw_value[0] == 's'))
+    return raw_value.substr(0, 1);
+  return {};
 }
 
