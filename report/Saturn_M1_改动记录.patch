+    const std::string combo =
+        name.substr(start, bar == std::string::npos ? std::string::npos : bar - start);
+    const uint64_t parsed = ParsePadCombo(Trim(combo));
+    if (parsed != 0)
+      return parsed;
+    if (bar == std::string::npos)
+      break;
+    start = bar + 1;
+  }
